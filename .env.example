# Copy to .env and fill in locally. Never commit real values.

# Only needed for the LLM-assisted features (pip install -e ".[ai]").
# The Anthropic SDK also picks up an `ant auth login` profile if this is unset.
ANTHROPIC_API_KEY=

# Model and effort for LLM-assisted match review and announcement extraction.
GAUGE_CLAUDE_MODEL=claude-opus-5
GAUGE_CLAUDE_EFFORT=medium
