# Copy to .env and fill in locally. Never commit real values.

# --- Storage -----------------------------------------------------------------
# Local working data (raw downloads, SQLite database). Ignored by git.
GAUGE_DATA_DIR=data/local
# GAUGE_DB_PATH=data/local/gauge.sqlite3

# Serve the frozen fixture snapshot instead of live data (demo without network).
GAUGE_DEMO_MODE=0

# --- Public data sources -----------------------------------------------------
# SEC asks automated clients to identify themselves with a contact email.
SEC_USER_AGENT="Gauge research your-email@example.com"
# USPTO trademark ingestion is a stretch feature and off by default (#4).
GAUGE_ENABLE_USPTO=0

# --- API ---------------------------------------------------------------------
GAUGE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- LLM-assisted features (pip install -e ".[ai]") --------------------------
# The Anthropic SDK also picks up an `ant auth login` profile if this is unset.
ANTHROPIC_API_KEY=
GAUGE_CLAUDE_MODEL=claude-opus-5
GAUGE_CLAUDE_EFFORT=medium
